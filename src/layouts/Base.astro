---
import '@fontsource-variable/source-serif-4/opsz.css';
import '@fontsource-variable/source-serif-4/opsz-italic.css';
import '@fontsource-variable/source-sans-3';
import '../styles/global.css';
import serifWoff from '@fontsource-variable/source-serif-4/files/source-serif-4-latin-opsz-normal.woff2?url';
import sansWoff from '@fontsource-variable/source-sans-3/files/source-sans-3-latin-wght-normal.woff2?url';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { SITE } from '../site.config';
import { url, absoluteUrl } from '../lib/url';
import { metaDescription } from '../lib/seo';

interface Props {
  title: string;
  description?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  /** Extra JSON-LD objects, built only from approved public fields. */
  jsonld?: Record<string, unknown>[];
  /** Exclude this page from the search index (e.g. search page itself). */
  searchable?: boolean;
  reviewed?: string;
  /** Search result type label for the Pagefind type filter. */
  searchType?: string;
  /** 2-4 word title for <title>; defaults to title. Checked by tools/check-ai-files.js. */
  shortTitle?: string;
  /** Link the Markdown twin (index.md). False only for pages without one, such as 404. */
  twin?: boolean;
}
const { title, description: rawDescription = SITE.description, type = 'website', noindex = false, jsonld = [], searchable = true, searchType = 'Page', shortTitle, twin = true } = Astro.props;
const description = metaDescription(rawDescription);
const fullTitle = `${shortTitle ?? title} | ${SITE.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const ogImage = absoluteUrl('brand/avatar-512.png', Astro.site);
const ld = jsonld;
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
// Prefetch (never prerender) same-site pages when a link is pressed, so visit counts stay true.
const speculation = { prefetch: [{ where: { and: [{ href_matches: `${base}*` }, { not: { href_matches: `${base}*.json` } }] }, eagerness: 'conservative' }] };
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="preload" as="font" type="font/woff2" href={serifWoff} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={sansWoff} crossorigin />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#141F52" />
    <link rel="icon" href={url('brand/favicon.ico')} sizes="16x16 32x32 48x48" />
    <link rel="icon" type="image/svg+xml" href={url('brand/favicon.svg')} sizes="any" />
    <link rel="apple-touch-icon" href={url('brand/apple-touch-icon.png')} />
    <link rel="manifest" href={url('site.webmanifest')} />
    <link rel="sitemap" type="application/xml" href={url('sitemap.xml')} />
    {twin && <link rel="alternate" type="text/markdown" href="index.md" title="Markdown version of this page" />}
    <link rel="alternate" type="application/atom+xml" href={url('feed.xml')} title="Critical Minerals changes" />
    <link rel="help" href={url('for-ai/')} title="Information for AI systems and agents" />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content="Critical Minerals logo: three folded bands under a red surface line" />
    <meta property="og:locale" content="en_GB" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={shortTitle ?? title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="Critical Minerals logo: three folded bands under a red surface line" />
    <meta data-pagefind-filter="type[content]" content={searchType} />
    {ld.length > 0 && <script type="application/ld+json" set:html={JSON.stringify(ld.length === 1 ? ld[0] : ld).replace(/</g, '\\u003c')} />}
    <script type="speculationrules" set:html={JSON.stringify(speculation)} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader />
    <main id="main" tabindex="-1" data-pagefind-body={searchable ? '' : undefined}>
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
