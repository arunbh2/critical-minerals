---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { url } from '../lib/url';
import { readingMinutes } from '../lib/status.js';
const parts = (await getCollection('learn')).filter((e) => !e.data.draft).sort((a, b) => a.data.order - b.data.order);
const total = parts.reduce((n, p) => n + readingMinutes(p.body), 0);
---
<Base title="Start here" description="A six-part, first-principles journey through critical minerals for development practitioners and funders new to the field.">
  <div class="wrap">
    <Breadcrumbs items={[{ label: 'Start here' }]} />
    <header class="reading">
      <p class="kicker red-rule">Learning journey</p>
      <h1>Start with the basics</h1>
      <p class="standfirst">Six short explainers that take you from the materials inside a phone to the questions that decide whether mineral development is fair. Written for colleagues with no technical background. Terms are defined where they first appear.</p>
      <p class="meta">{parts.length} parts · about {total} minutes in total</p>
    </header>
    <ol class="journey reading">
      {parts.map((p) => (
        <li>
          <span class="journey-num" aria-hidden="true">{p.data.order}</span>
          <div>
            <h2><a href={url(`learn/${p.id}/`)}>{p.data.title}</a></h2>
            <p class="journey-q">{p.data.question}</p>
            <p>{p.data.summary}</p>
            <p class="meta">{readingMinutes(p.body)} min read</p>
          </div>
        </li>
      ))}
    </ol>
    <div class="reading panel">
      <h2 class="kicker">After the journey</h2>
      <p>Apply what you have learned with the <a href={url('tools/community-benefit/')}>community-benefit worksheet</a>, or go deeper on <a href={url('countries/india/')}>India</a> and <a href={url('countries/indonesia/')}>Indonesia</a>.</p>
    </div>
  </div>
</Base>
<style>
  .journey { list-style: none; padding: 0; margin: 1.5rem 0 2rem; }
  .journey > li { display: grid; grid-template-columns: 3rem 1fr; gap: var(--gap); padding: 1rem 0; border-top: 1px solid var(--color-rule); margin: 0; }
  .journey-num { font-family: var(--font-serif); font-size: 2rem; font-weight: 700; color: var(--color-signature); line-height: 1; }
  .journey h2 { margin: 0 0 0.25rem; font-size: 1.3rem; }
  .journey h2 a { text-decoration: none; }
  .journey h2 a:hover { text-decoration: underline; }
  .journey-q { color: var(--chicago-30); margin-bottom: 0.4rem; }
  .journey p { margin-bottom: 0.3rem; }
</style>
