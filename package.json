    "@fontsource-variable/source-sans-3": "5.3.1",
    "@fontsource-variable/source-serif-4": "5.3.1",
    "astro": "7.4.12"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "axe-core": "4.14.1",
    "pagefind": "1.6.0",
    "pdfjs-dist": "4.10.38",
    "playwright": "1.63.0",
    "typescript": "6.0.3",
    "yaml": "2.9.1"
  }
